<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:CaDesk.Desktop.ViewModels" xmlns:v="clr-namespace:CaDesk.Desktop.Views" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="CaDesk.Desktop.MainWindow" Title="CA Desk" Icon="Assets/CaDesk.ico" Width="1420" Height="900" MinWidth="1000" MinHeight="680" WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen" Background="#F8FAFC" Foreground="#0F172A" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="48"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E2E8F0"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#CBD5E1"/>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="BorderBrush" Value="#2563EB"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#DC2626"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Setter Property="Background" Value="#B91C1C"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <v:DashboardView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ClientsViewModel}">
      <v:ClientsView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WorkTableViewModel}">
      <v:WorkTableView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
      <v:CalendarView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NotesViewModel}"><v:NotesView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <v:SettingsView/>
    </DataTemplate>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="Margin" Value="0,3"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Section}" Value="Dashboard">
          <Setter Property="Tag" Value="Dashboard"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewItemCommand}"/>
    <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}"/>
  </Window.InputBindings>
  <Grid x:Name="WindowLayoutRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="216"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" ToolTip="Minimize" AutomationProperties.Name="Minimize">
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButton}" Click="ToggleMaximizeWindow" ToolTip="Maximize" AutomationProperties.Name="Maximize">
            <TextBlock x:Name="MaximizeRestoreIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Click="CloseWindow" ToolTip="Close" AutomationProperties.Name="Close">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
          <Image Source="Assets/CaDesk.ico" Width="20" Height="20" Margin="0,0,10,0"/>
          <TextBlock Text="CA Desk" FontSize="12" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="#0F172A">
      <Grid Margin="16,28,16,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="12,0,0,36">
          <StackPanel Orientation="Horizontal">
            <Border Background="#2563EB" CornerRadius="8" Width="34" Height="34" Margin="0,0,10,0">
              <TextBlock Text="CA" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="CA Desk" Foreground="White" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Your practice, in focus." Foreground="#94A3B8" FontSize="12" Margin="0,14,0,0"/>
          <TextBlock x:Name="SidebarProfileName" Text="{Binding ProfileName}" ToolTip="{Binding ProfileName}" Foreground="#CBD5E1" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,18,0,0" Visibility="{Binding HasProfileName,Converter={StaticResource Visible}}"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Text="WORKSPACE" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="16,0,0,12"/>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Section}" Value="Dashboard">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="White"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
              <TextBlock Text="Dashboard" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Clients">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Section}" Value="Clients">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="White"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
              <TextBlock Text="Clients" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Calendar">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Section}" Value="Calendar">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="White"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
              <TextBlock Text="Calendar" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding NavigateCommand}" CommandParameter="Master Work Table">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Section}" Value="Master Work Table">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="White"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
              <TextBlock Text="Master Work Table" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="3">
          <Button Command="{Binding NavigateCommand}" CommandParameter="Settings">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource Nav}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Section}" Value="Settings">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="White"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,12,0"/>
              <TextBlock Text="Settings" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
          </Button>
          <Border BorderBrush="#1E293B" BorderThickness="0,1,0,0" Margin="12,20,12,0" Padding="0,18,0,0">
            <StackPanel>
              <TextBlock Text="●  Saved on this computer" Foreground="#94A3B8" FontSize="11"/>
              <TextBlock Text="Offline · Single-user workspace" Foreground="#64748B" FontSize="10" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="62"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Background="White" Padding="30,0">
        <DockPanel>
          <Button x:Name="NotesNavigation" DockPanel.Dock="Right" Command="{Binding NavigateCommand}" CommandParameter="Notes" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Personal study notes" AutomationProperties.Name="Notes">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#FAF5FF"/><Setter Property="BorderBrush" Value="#EDE9FE"/><Setter Property="Foreground" Value="#7C3AED"/>
                <Style.Triggers><DataTrigger Binding="{Binding Section}" Value="Notes"><Setter Property="Background" Value="#EDE9FE"/><Setter Property="BorderBrush" Value="#C4B5FD"/></DataTrigger></Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" Foreground="#7C3AED" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Notes" Foreground="#7C3AED" FontWeight="SemiBold"/></StackPanel>
          </Button>
          <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
            <TextBlock x:Name="WelcomeGreeting" Text="{Binding Greeting}" ToolTip="{Binding Greeting}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding TodayLabel}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" Margin="28,16,28,0" Background="#FEF2F2" CornerRadius="8" Padding="14" Visibility="{Binding HasMessage,Converter={StaticResource Visible}}">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="×" Command="{Binding DismissMessageCommand}" Style="{StaticResource Link}"/>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#B91C1C"/>
        </DockPanel>
      </Border>
      <ContentControl x:Name="PageHost" Grid.Row="2" Content="{Binding CurrentPage}" Margin="28"/>
      <Border Grid.Row="2" Background="#F8FAFC" Visibility="{Binding IsBusy,Converter={StaticResource Visible}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="220" Height="4"/>
          <TextBlock Text="Opening your workspace…" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
