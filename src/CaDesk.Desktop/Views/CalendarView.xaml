<UserControl x:Class="CaDesk.Desktop.Views.CalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Calendar" Style="{StaticResource PageTitle}"/><TextBlock Text="{Binding Title}" Margin="0,16,0,16"/><StackPanel Orientation="Horizontal"><Button Content="Previous" Command="{Binding PreviousCommand}"/><Button Content="Today" Command="{Binding TodayCommand}"/><Button Content="Next" Command="{Binding NextCommand}"/></StackPanel></StackPanel><ScrollViewer><ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,12"><TextBlock Text="{Binding FullLabel}"/><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding OpenCommand}" Content="{Binding Name}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></DockPanel></UserControl>