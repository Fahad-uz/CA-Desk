<UserControl x:Class="CaDesk.Desktop.Views.CalendarView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:CaDesk.Desktop.ViewModels">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,24"><StackPanel><TextBlock Text="Calendar" Style="{StaticResource PageTitle}"/><TextBlock Text="Your deadlines, clearly mapped out." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel><ComboBox ItemsSource="{Binding ClientOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClientFilter}" Width="220" HorizontalAlignment="Right" VerticalAlignment="Top" AutomationProperties.Name="Calendar client filter"/></DockPanel>
 <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding ResultLabel}" Style="{StaticResource Caption}" FontSize="12" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="‹" Command="{Binding PreviousCommand}" ToolTip="Previous period" Padding="12,7"/><Button Content="Today" Command="{Binding TodayCommand}" Margin="6,0"/><Button Content="›" Command="{Binding NextCommand}" ToolTip="Next period" Padding="12,7" Margin="0,0,18,0"/>
 <Button Content="Month" Command="{Binding ViewCommand}" CommandParameter="Month"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:CalendarMode.Month}"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#BFDBFE"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
 <Button Content="Week" Command="{Binding ViewCommand}" CommandParameter="Week" Margin="6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:CalendarMode.Week}"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#BFDBFE"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
 <Button Content="Day" Command="{Binding ViewCommand}" CommandParameter="Day"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="{x:Static vm:CalendarMode.Day}"><Setter Property="Background" Value="#EFF6FF"/><Setter Property="Foreground" Value="#2563EB"/><Setter Property="BorderBrush" Value="#BFDBFE"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
 </WrapPanel></Grid>
 <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Visibility="{Binding IsMonth,Converter={StaticResource Visible}}"><Border Style="{StaticResource Card}" Padding="0" MinWidth="800"><StackPanel><UniformGrid Columns="7" Background="#F8FAFC"><TextBlock Text="MON" Margin="14,12" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="TUE" Margin="14,12" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="WED" Margin="14,12" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="THU" Margin="14,12" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="FRI" Margin="14,12" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="SAT" Margin="14,12" Style="{StaticResource Caption}" FontSize="11"/><TextBlock Text="SUN" Margin="14,12" Style="{StaticResource Caption}" FontSize="11"/></UniformGrid>
 <ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E2E8F0" BorderThickness="0,1,1,0" MinHeight="144" Padding="7"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Background" Value="#F8FAFC"/></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="#EFF6FF"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><Button Content="{Binding Label}" Command="{Binding OpenDayCommand}" Padding="5,1" HorizontalAlignment="Left" Margin="0,0,0,6" ToolTip="Show all deadlines for this day"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Link}"><Setter Property="Foreground" Value="#64748B"/><Style.Triggers><DataTrigger Binding="{Binding HasOverdue}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Foreground" Value="#2563EB"/><Setter Property="FontWeight" Value="Bold"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding OpenCommand}" Background="Transparent" BorderBrush="Transparent" Padding="3,3" HorizontalContentAlignment="Stretch" ToolTip="{Binding CalendarLabel}"><DockPanel><Border DockPanel.Dock="Left" Width="3" Background="{Binding Status,Converter={StaticResource StatusBrush}}" CornerRadius="1" Margin="0,1,6,1"/><StackPanel><TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="{Binding Status,Converter={StaticResource StatusBrush}}"/><TextBlock Text="{Binding ClientName}" FontSize="9" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DockPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="{Binding MoreLabel}" Command="{Binding OpenDayCommand}" Style="{StaticResource Link}" FontSize="10" Padding="4,2" Visibility="{Binding HasMore,Converter={StaticResource Visible}}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></Border></ScrollViewer>
 <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAgenda,Converter={StaticResource Visible}}"><ItemsControl ItemsSource="{Binding Days}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20"><StackPanel><DockPanel Margin="0,0,0,12"><Button Content="{Binding FullLabel}" Command="{Binding OpenDayCommand}" Style="{StaticResource Link}" FontWeight="SemiBold" Foreground="#0F172A"/><TextBlock Text="TODAY" Foreground="#2563EB" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsToday,Converter={StaticResource Visible}}"/></DockPanel><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><Button Command="{Binding OpenClientCommand}" Style="{StaticResource Link}"><TextBlock Text="{Binding ClientName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ClientName}"/></Button><Button Grid.Column="1" Command="{Binding OpenCommand}" Style="{StaticResource Link}" Foreground="#0F172A"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></Button><TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Foreground="{Binding Status,Converter={StaticResource StatusBrush}}" VerticalAlignment="Center" FontSize="12"/><TextBlock Grid.Column="3" Text="{Binding DeadlineLabel}" VerticalAlignment="Center" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Grid.Column="4" Content="Details" Command="{Binding OpenCommand}" Style="{StaticResource Link}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="No deadlines for this day." Style="{StaticResource Caption}" Margin="0,8" Visibility="{Binding IsEmpty,Converter={StaticResource Visible}}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </Grid>
</UserControl>