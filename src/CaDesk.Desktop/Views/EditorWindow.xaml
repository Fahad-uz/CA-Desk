<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:CaDesk.Desktop.ViewModels" x:Class="CaDesk.Desktop.Views.EditorWindow" Title="{Binding Title}" Width="580" Height="680" MinWidth="440" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#F8FAFC" Foreground="#0F172A" FontFamily="Segoe UI" FontSize="14" ShowInTaskbar="False">
  <Window.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/></Window.InputBindings>
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:ClientEditorViewModel}">
      <StackPanel>
        <TextBlock Text="Client name" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Client name"/>
        <TextBlock Text="Client due date (optional)" FontWeight="SemiBold" Margin="0,22,0,8"/>
        <DatePicker SelectedDate="{Binding DueDate}" AutomationProperties.Name="Client due date"/>
        <Button Content="Remove due date" Command="{Binding ClearDueDateCommand}" Style="{StaticResource Link}" HorizontalAlignment="Left" FontSize="11"/>
        <TextBlock Text="Description / notes" FontWeight="SemiBold" Margin="0,22,0,8"/>
        <TextBox Text="{Binding Description,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="180" VerticalContentAlignment="Top" AutomationProperties.Name="Client notes"/>
        <TextBlock Text="A simple workspace to keep this client's work organised." Style="{StaticResource Caption}" Margin="0,18,0,0"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:NoteEditorViewModel}">
      <StackPanel>
        <TextBlock Text="Heading" Foreground="#7C3AED" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox Text="{Binding Heading,UpdateSourceTrigger=PropertyChanged}" FontSize="20" Padding="12" AutomationProperties.Name="Note heading"/>
        <Grid Margin="0,20,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <DatePicker SelectedDate="{Binding NoteDate}" AutomationProperties.Name="Note date"/>
          <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Foreground="#8B5CF6" Margin="18,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
        <TextBlock Text="Your note" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox Text="{Binding Body,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="360" Padding="16" FontSize="15" VerticalContentAlignment="Top" AutomationProperties.Name="Study note body"/>
        <TextBlock Text="Plain text · Line breaks preserved · Ctrl+S to save" Style="{StaticResource Caption}" FontSize="11" Margin="0,12,0,0"/>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:WorkEditorViewModel}">
      <StackPanel>
        <TextBlock Text="Client" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ComboBox ItemsSource="{Binding Clients}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClientId}" AutomationProperties.Name="Client"/>
        <TextBlock Text="Work area name" FontWeight="SemiBold" Margin="0,18,0,8"/>
        <TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Work area name"/>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Status" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{x:Static vm:Options.Statuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Status}" Foreground="{Binding Status,Converter={StaticResource StatusBrush}}" AutomationProperties.Name="Status"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Deadline (optional)" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DatePicker SelectedDate="{Binding Deadline}" AutomationProperties.Name="Deadline"/>
            <Button Content="Remove deadline" Command="{Binding ClearDeadlineCommand}" Style="{StaticResource Link}" FontSize="11"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,12,0,8"/>
        <TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="140" VerticalContentAlignment="Top" AutomationProperties.Name="Work area notes"/>
        <Button Content="Save &amp; open client →" Command="{Binding OpenClientCommand}" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Changes are saved locally on this computer." Style="{StaticResource Caption}" Margin="0,6,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ContentControl Content="{Binding}" IsEnabled="{Binding CanEdit}"/>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FEF2F2" CornerRadius="7" Padding="12" Margin="0,16,0,0" Visibility="{Binding HasError,Converter={StaticResource Visible}}">
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="#B91C1C"/>
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="Cancel" IsCancel="True" IsEnabled="{Binding CanEdit}" Margin="0,0,10,0"/>
      <Button Content="Save changes" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource Primary}"/>
    </StackPanel>
  </Grid>
</Window>
