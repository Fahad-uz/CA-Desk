<UserControl x:Class="CaDesk.Desktop.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CaDesk.Desktop.Controls" SizeChanged="OnSizeChanged">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
 <DockPanel Margin="0,0,0,26"><Button DockPanel.Dock="Right" Content="＋  Add Client" Command="{Binding AddClientCommand}" Style="{StaticResource Primary}" VerticalAlignment="Top"/><StackPanel><TextBlock Text="Your practice at a glance" Style="{StaticResource PageTitle}"/><TextBlock Text="Stay close to your clients, progress and upcoming deadlines." Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></DockPanel>
 <ItemsControl ItemsSource="{Binding Cards}" Margin="-6,0,-6,24"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding Command}" Margin="6" Background="White" Padding="20,18" HorizontalContentAlignment="Stretch"><StackPanel><DockPanel><TextBlock Text="{Binding Label}" Foreground="#64748B" FontSize="12"/><TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding Color}" FontSize="15" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="{Binding Count}" FontSize="32" FontWeight="SemiBold" Margin="0,12,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="1.12*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Work distribution" Style="{StaticResource SectionTitle}"/><Button Content="View work →" Command="{Binding AllWorkCommand}" Style="{StaticResource Link}" HorizontalAlignment="Right" VerticalAlignment="Top"/></DockPanel><WrapPanel HorizontalAlignment="Center" Margin="0,4,0,8"><Grid Width="200" Height="200" Margin="0,0,20,0"><c:DonutChart NotStarted="{Binding Progress.NotStarted}" InProgress="{Binding Progress.InProgress}" Completed="{Binding Progress.Completed}" AutomationProperties.Name="Work status distribution"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding Progress.Percentage,StringFormat={}{0:0}%}" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="complete" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Grid><StackPanel VerticalAlignment="Center" MinWidth="120"><DockPanel Margin="0,0,0,18"><Ellipse Width="8" Height="8" Fill="#94A3B8" Margin="0,0,8,0"/><TextBlock Text="Not Started" FontSize="12"/><TextBlock Text="{Binding NotStartedShare}" HorizontalAlignment="Right" Margin="14,0,0,0" FontWeight="SemiBold" FontSize="12"/></DockPanel><DockPanel Margin="0,0,0,18"><Ellipse Width="8" Height="8" Fill="#2563EB" Margin="0,0,8,0"/><TextBlock Text="In Progress" FontSize="12"/><TextBlock Text="{Binding InProgressShare}" HorizontalAlignment="Right" Margin="14,0,0,0" FontWeight="SemiBold" FontSize="12"/></DockPanel><DockPanel><Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,8,0"/><TextBlock Text="Completed" FontSize="12"/><TextBlock Text="{Binding CompletedShare}" HorizontalAlignment="Right" Margin="14,0,0,0" FontWeight="SemiBold" FontSize="12"/></DockPanel></StackPanel></WrapPanel><TextBlock Text="{Binding Progress.Label}" Style="{StaticResource Caption}" HorizontalAlignment="Center"/></StackPanel></Border>
 <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Client progress" Style="{StaticResource SectionTitle}"/><Button Content="All clients →" Command="{Binding AllClientsCommand}" Style="{StaticResource Link}" HorizontalAlignment="Right" VerticalAlignment="Top"/></DockPanel><ScrollViewer Height="240" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Clients}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,20"><DockPanel><Button Command="{Binding OpenCommand}" Style="{StaticResource Link}"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding Name}" Foreground="#0F172A" FontWeight="SemiBold" FontSize="13"/></Button></DockPanel><TextBlock Text="{Binding Progress.Label}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,8"/><ProgressBar Value="{Binding Progress.Percentage}" Height="5"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border>
 </Grid>
 <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20"><StackPanel><DockPanel Margin="24,20,24,16"><StackPanel><TextBlock Text="Nearest unfinished deadlines" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Overdue work stays visible until it is complete." Style="{StaticResource Caption}" FontSize="12" Margin="0,5,0,0"/></StackPanel><Button Content="View all work →" Command="{Binding AllWorkCommand}" Style="{StaticResource Link}" HorizontalAlignment="Right" VerticalAlignment="Top"/></DockPanel><ItemsControl ItemsSource="{Binding Upcoming}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="24,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="135"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ClientName}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ClientName}" Margin="0,0,16,0"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}" Margin="0,0,16,0"/><TextBlock Grid.Column="2" Text="{Binding DeadlineLabel}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Grid.Column="3" Background="#F8FAFC" CornerRadius="5" Padding="8,5"><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding Status,Converter={StaticResource StatusBrush}}" FontSize="12"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="No unfinished deadlines. Add deadlines to your work areas to see them here." Style="{StaticResource Caption}" Margin="24,0,24,24" Visibility="{Binding NoUpcoming,Converter={StaticResource Visible}}"/></StackPanel></Border>
 <Border Background="#EFF6FF" CornerRadius="10" Padding="22" Visibility="{Binding IsEmpty,Converter={StaticResource Visible}}"><DockPanel><Button DockPanel.Dock="Right" Content="Add Client" Command="{Binding AddClientCommand}" Style="{StaticResource Primary}"/><StackPanel><TextBlock Text="Start with a client" FontWeight="SemiBold"/><TextBlock Text="Add work areas, choose deadlines, and your overview will take shape." Style="{StaticResource Caption}" Margin="0,5,16,0"/></StackPanel></DockPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>