<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CaDesk.Desktop.Controls" x:Class="CaDesk.Desktop.Views.ClientsView">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24">
      <Button DockPanel.Dock="Right" Content="＋  Add Client" Command="{Binding AddCommand}" Style="{StaticResource Primary}" VerticalAlignment="Top"/>
      <StackPanel>
        <TextBlock Text="Clients" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="A dedicated workspace for every client." Style="{StaticResource Caption}" Margin="0,7,0,0"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBox Tag="Search clients by name…" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged,Delay=120}" Width="280" ToolTip="Search clients by name" AutomationProperties.Name="Search clients"/>
        <Button Content="×" Command="{Binding ClearSearchCommand}" ToolTip="Clear search" Margin="6,0,16,0"/>
        <TextBlock Text="{Binding ResultLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
      </StackPanel>
      <CheckBox Grid.Column="1" Content="Compact table" IsChecked="{Binding TableView}" VerticalAlignment="Center"/>
    </Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding CardView,Converter={StaticResource Visible}}">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Width="310" Margin="0,0,16,16">
              <StackPanel>
                <DockPanel>
                  <Border DockPanel.Dock="Left" Background="#EFF6FF" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Initials}" Foreground="#2563EB" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Button Command="{Binding OpenCommand}" Style="{StaticResource Link}" ToolTip="{Binding Name}">
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="200"/>
                  </Button>
                </DockPanel>
                <TextBlock Text="{Binding DueDateLabel,StringFormat=Due: {0}}" Style="{StaticResource Caption}" Margin="0,16,0,3"/>
                <TextBlock Text="{Binding DaysRemainingLabel}" Foreground="{Binding DueColor}" FontSize="12"/>
                <TextBlock Text="{Binding Progress.Label}" Style="{StaticResource Caption}" Margin="0,24,0,8"/>
                <ProgressBar c:SmoothProgress.Value="{Binding Progress.Percentage,Mode=OneWay}"/>
                <UniformGrid Columns="3" Margin="0,20,0,20">
                  <StackPanel>
                    <TextBlock Text="{Binding Progress.NotStarted}" FontSize="20"/>
                    <TextBlock Text="Not started" Style="{StaticResource Caption}" FontSize="11"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Progress.InProgress}" Foreground="#2563EB" FontSize="20"/>
                    <TextBlock Text="In progress" Style="{StaticResource Caption}" FontSize="11"/>
                  </StackPanel>
                  <StackPanel>
                    <TextBlock Text="{Binding Progress.Completed}" Foreground="#16A34A" FontSize="20"/>
                    <TextBlock Text="Completed" Style="{StaticResource Caption}" FontSize="11"/>
                  </StackPanel>
                </UniformGrid>
                <DockPanel>
                  <Button Content="Open workspace →" Command="{Binding OpenCommand}" Style="{StaticResource Link}"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Edit" Command="{Binding EditCommand}" Padding="9,5"/>
                    <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource Danger}" Padding="9,5" Margin="6,0,0,0"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Visibility="{Binding TableView,Converter={StaticResource Visible}}">
      <DataGrid ItemsSource="{Binding Items}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="Client" Width="2*" MinWidth="190">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Command="{Binding OpenCommand}" Style="{StaticResource Link}">
                  <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                </Button>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Due date" Binding="{Binding DueDateLabel}" Width="125"/>
          <DataGridTextColumn Header="Days remaining" Binding="{Binding DaysRemainingLabel}" Width="150"/>
          <DataGridTextColumn Header="Work areas" Binding="{Binding Progress.Total}" Width="100"/>
          <DataGridTextColumn Header="Completed" Binding="{Binding Progress.Completed}" Width="100"/>
          <DataGridTextColumn Header="In progress" Binding="{Binding Progress.InProgress}" Width="100"/>
          <DataGridTextColumn Header="Not started" Binding="{Binding Progress.NotStarted}" Width="100"/>
          <DataGridTextColumn Header="Progress" Binding="{Binding Progress.Label}" Width="170"/>
          <DataGridTemplateColumn Header="Actions" Width="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Edit" Command="{Binding EditCommand}" Padding="8,5"/>
                  <Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource Danger}" Padding="8,5" Margin="5,0,0,0"/>
                </StackPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding IsEmpty,Converter={StaticResource Visible}}" VerticalAlignment="Top" Margin="0,32,0,0">
      <StackPanel HorizontalAlignment="Center" Margin="30">
        <TextBlock Text="Your clients belong here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        <TextBlock Text="Add your first client, or clear your search to see existing clients." Style="{StaticResource Caption}" Margin="0,12,0,20"/>
        <Button Content="Add Client" Command="{Binding AddCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
