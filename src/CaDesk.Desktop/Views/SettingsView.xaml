<?xml version="1.0" ?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CaDesk.Desktop.Views.SettingsView">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
      <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="Simple by design. Everything stays on this computer." Style="{StaticResource Caption}" Margin="0,8,0,28"/>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="Your profile" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Add your name for a personal welcome when you open CA Desk." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
          <StackPanel IsEnabled="{Binding CanUse}" Margin="0,18,0,0">
            <Label Content="Your name" Target="{Binding ElementName=ProfileNameInput}" Padding="0,0,0,8"/>
            <TextBox x:Name="ProfileNameInput" Text="{Binding ProfileName,UpdateSourceTrigger=PropertyChanged}" MaxLength="80" MaxWidth="420" HorizontalAlignment="Left" MinWidth="280" AutomationProperties.Name="Your profile name"/>
            <Button x:Name="SaveProfileButton" Content="Save name" Click="SaveProfile" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding ProfileMessage}" Foreground="#2563EB" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
          <TextBlock Text="Your name is kept on this computer and included in backups. Leave it blank to clear it." Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="CA Desk" FontSize="24" FontWeight="SemiBold"/>
          <TextBlock Text="Work management for Chartered Accountants" Style="{StaticResource Caption}" Margin="0,6,0,20"/>
          <TextBlock Text="{Binding Version,StringFormat=Version {0}}"/>
          <TextBlock Text="Windows 10 &amp; Windows 11 · 64-bit" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="Local data storage" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Clients, work areas, deadlines and notes are saved automatically to a SQLite database in your Windows user profile." TextWrapping="Wrap" Style="{StaticResource Caption}"/>
          <Border Background="#F8FAFC" CornerRadius="6" Padding="14" Margin="0,18,0,16">
            <TextBlock Text="{Binding DatabasePath}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
          </Border>
          <Button Content="Open data folder" Click="OpenFolder" HorizontalAlignment="Left"/>
          <TextBlock Text="Application updates keep this database. The portable app can be replaced without moving or resetting your data." TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="0,0,0,20">
        <StackPanel>
          <TextBlock Text="Backup &amp; Restore" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Keep a complete copy of your clients, work areas, study notes and preferences. Daily automatic backups and pre-update recovery copies are saved locally." Style="{StaticResource Caption}" TextWrapping="Wrap"/>
          <WrapPanel Margin="0,20,0,14" IsEnabled="{Binding CanUse}">
            <Button Content="Export Backup" Click="ExportBackup" Style="{StaticResource Primary}" Margin="0,0,10,8"/>
            <Button Content="Restore Backup" Click="RestoreBackup" Margin="0,0,10,8"/>
            <Button Content="Open backups folder" Click="OpenBackups" Margin="0,0,0,8"/>
          </WrapPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#2563EB" FontSize="12"/>
          <TextBlock Text="Restore replaces your current data after confirmation. Keep an exported copy on another drive for protection from computer or disk failure." Style="{StaticResource Caption}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/>
          <TextBlock Text="Refined light theme with clear status colours and native Windows controls. Windows display scaling and keyboard navigation are supported." TextWrapping="Wrap" Style="{StaticResource Caption}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
