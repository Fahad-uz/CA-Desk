<UserControl x:Class="CaDesk.Desktop.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="800" HorizontalAlignment="Left"><TextBlock Text="Settings" Style="{StaticResource PageTitle}"/><TextBlock Text="Simple by design. Everything stays on this computer." Style="{StaticResource Caption}" Margin="0,8,0,28"/><Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="CA Desk" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Work management for Chartered Accountants" Style="{StaticResource Caption}" Margin="0,6,0,20"/><TextBlock Text="{Binding Version,StringFormat=Version {0}}"/><TextBlock Text="Windows 10 &amp; Windows 11 · 64-bit" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Local data storage" Style="{StaticResource SectionTitle}"/><TextBlock Text="Clients, work areas, deadlines and notes are saved automatically to a SQLite database in your Windows user profile." Style="{StaticResource Caption}"/><Border Background="#F8FAFC" CornerRadius="6" Padding="14" Margin="0,18,0,16"><TextBlock Text="{Binding DatabasePath}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/></Border><Button Content="Open data folder" Click="OpenFolder" HorizontalAlignment="Left"/><TextBlock Text="Application updates keep this database. The portable app can be replaced without moving or resetting your data." Style="{StaticResource Caption}" Margin="0,16,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Appearance" Style="{StaticResource SectionTitle}"/><TextBlock Text="Refined light theme with clear status colours and native Windows controls. Windows display scaling and keyboard navigation are supported." Style="{StaticResource Caption}"/></StackPanel></Border></StackPanel></ScrollViewer></UserControl>