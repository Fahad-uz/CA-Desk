<UserControl x:Class="CaDesk.Desktop.Views.WorkTableView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:CaDesk.Desktop.Controls" xmlns:vm="clr-namespace:CaDesk.Desktop.ViewModels">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <DockPanel Margin="0,0,0,22"><Button DockPanel.Dock="Right" Content="＋  Add Work Area" Command="{Binding AddCommand}" Style="{StaticResource Primary}" VerticalAlignment="Top"/><StackPanel><StackPanel Orientation="Horizontal" Visibility="{Binding IsWorkspace,Converter={StaticResource Visible}}" Margin="0,0,0,12"><Button Content="← Clients" Command="{Binding BackCommand}" Style="{StaticResource Link}"/><Button Content="Edit client" Command="{Binding EditClientCommand}" Style="{StaticResource Link}" Margin="20,0,0,0"/></StackPanel><TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Title}"/><TextBlock Text="{Binding Subtitle}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,7,16,0" MaxHeight="42" TextTrimming="CharacterEllipsis"/></StackPanel></DockPanel>
 <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,20" Visibility="{Binding IsWorkspace,Converter={StaticResource Visible}}"><StackPanel><TextBlock Text="{Binding Progress.Label}" Margin="0,0,0,8"/><ProgressBar c:SmoothProgress.Value="{Binding Progress.Percentage,Mode=OneWay}"/></StackPanel></Border>
 <StackPanel Grid.Row="2" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Tag="Search clients or work areas…" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged,Delay=120}" ToolTip="Search client or work area names" AutomationProperties.Name="Search work areas"/><Button Grid.Column="1" Content="×" Command="{Binding ClearSearchCommand}" Margin="8,0,0,0" ToolTip="Clear search"/></Grid><WrapPanel Margin="0,12,0,0"><ComboBox ItemsSource="{x:Static vm:Options.StatusFilters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding StatusFilter}" Width="145" Margin="0,0,10,8" AutomationProperties.Name="Filter by status"/><ComboBox ItemsSource="{x:Static vm:Options.Deadlines}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DeadlineFilter}" Width="145" Margin="0,0,10,8" AutomationProperties.Name="Filter by deadline"/><ComboBox ItemsSource="{Binding ClientOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ClientFilter}" Width="185" Margin="0,0,10,8" AutomationProperties.Name="Filter by client"/><Button Content="Reset Filters" Command="{Binding ResetCommand}" Style="{StaticResource Link}" Margin="4,0,0,8"/></WrapPanel><DockPanel><TextBlock Text="{Binding ResultLabel}" Style="{StaticResource Caption}"/><TextBlock Text="{Binding SortLabel}" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel></StackPanel>
 <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="WorkGrid" ItemsSource="{Binding Items}" Sorting="OnSorting"><DataGrid.Columns>
 <DataGridTemplateColumn Header="Client" SortMemberPath="Client" CanUserSort="True" Width="160" MinWidth="140"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Command="{Binding OpenClientCommand}" Style="{StaticResource Link}"><TextBlock Text="{Binding ClientName}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding ClientName}"/></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="Work Area" SortMemberPath="Name" CanUserSort="True" Width="*" MinWidth="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{Binding Status,Converter={StaticResource StatusBrush}}" Margin="0,0,10,0"/><Button Command="{Binding OpenCommand}" Style="{StaticResource Link}" Foreground="#0F172A"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/></Button></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="Status" SortMemberPath="Status" CanUserSort="True" Width="165"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{x:Static vm:Options.Statuses}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Status,UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding Status,Converter={StaticResource StatusBrush}}" AutomationProperties.Name="Work status"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="Deadline" SortMemberPath="Deadline" CanUserSort="True" Width="185"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><DockPanel><Button DockPanel.Dock="Right" Content="×" Command="{Binding ClearDeadlineCommand}" Style="{StaticResource Link}" ToolTip="Remove deadline" Padding="4,0"/><DatePicker SelectedDate="{Binding Deadline,UpdateSourceTrigger=PropertyChanged}" ToolTip="Set or edit deadline" AutomationProperties.Name="Work deadline"/></DockPanel><TextBlock Text="{Binding DeadlineLabel}" FontSize="10" Margin="2,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#64748B"/><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#DC2626"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="Notes" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Command="{Binding OpenCommand}" Style="{StaticResource Link}" ToolTip="View or edit notes"><DockPanel><TextBlock DockPanel.Dock="Left" Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" Margin="0,0,7,0" Visibility="{Binding HasNotes,Converter={StaticResource Visible}}"/><TextBlock Text="{Binding NotesPreview}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="95"/></DockPanel></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="Actions" Width="132"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="Edit" Command="{Binding OpenCommand}" Padding="8,5"/><Button Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource Danger}" Padding="8,5" Margin="5,0,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 </DataGrid.Columns></DataGrid><StackPanel Visibility="{Binding IsEmpty,Converter={StaticResource Visible}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30"><TextBlock Text="No work areas to show" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Create a work area or reset your search and filters." Style="{StaticResource Caption}" Margin="0,10,0,20"/><Button Content="Add Work Area" Command="{Binding AddCommand}" Style="{StaticResource Primary}" HorizontalAlignment="Center"/></StackPanel></Grid></Border>
 </Grid>
</UserControl>