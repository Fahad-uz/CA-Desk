<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CaDesk.Desktop.Views.NotesView">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,26">
      <Button DockPanel.Dock="Right" Content="＋  New Note" Command="{Binding AddCommand}" Style="{StaticResource Primary}" Background="#8B5CF6" BorderBrush="#8B5CF6" VerticalAlignment="Top" ToolTip="New study note (Ctrl+N)"/>
      <StackPanel>
        <TextBlock Text="PERSONAL STUDY" Foreground="#8B5CF6" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock Text="Notes" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="Your ideas, discoveries and daily learning." Style="{StaticResource Caption}" Margin="0,8,0,0"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Tag="Search headings and note bodies…" Width="270" AutomationProperties.Name="Search study notes"/>
        <Button Content="×" Command="{Binding ClearSearchCommand}" ToolTip="Clear search" Margin="6,0,18,0"/>
        <TextBlock Text="{Binding CountLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding ResultLabel}" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center"/>
    </Grid>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Width="340" Height="246" Padding="22" Margin="0,0,16,16" BorderBrush="#EDE9FE">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding DateLabel}" Foreground="#8B5CF6" FontSize="11" FontWeight="SemiBold"/>
                <Button Grid.Row="1" Command="{Binding OpenCommand}" Style="{StaticResource Link}" Foreground="#0F172A" Padding="0" Margin="0,12,0,10" HorizontalContentAlignment="Left">
                  <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="50" ToolTip="{Binding Heading}"/>
                </Button>
                <TextBlock Grid.Row="2" Text="{Binding Preview}" Foreground="#64748B" FontSize="13" LineHeight="21" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="63" VerticalAlignment="Top"/>
                <DockPanel Grid.Row="3" Margin="0,16,0,0">
                  <Button DockPanel.Dock="Right" Content="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource Danger}" Padding="9,5"/>
                  <Button Content="Open note →" Command="{Binding OpenCommand}" Style="{StaticResource Link}" Foreground="#8B5CF6" HorizontalAlignment="Left"/>
                </DockPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Border Grid.Row="2" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding IsEmpty,Converter={StaticResource Visible}}" Padding="44" BorderBrush="#EDE9FE">
      <StackPanel HorizontalAlignment="Center" MaxWidth="440">
        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#8B5CF6" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,24"/>
        <Button Content="New Note" Command="{Binding AddCommand}" Style="{StaticResource Primary}" Background="#8B5CF6" BorderBrush="#8B5CF6" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
